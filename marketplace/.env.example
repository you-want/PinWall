# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=pinwall
DB_PASSWORD=pinwall
DB_NAME=pinwall_marketplace

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development

# CORS (comma separated)
CORS_ORIGIN=http://localhost:1420,tauri://localhost

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# S3 (if STORAGE_TYPE=s3)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
