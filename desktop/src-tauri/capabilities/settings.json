{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Capability for the settings window",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "shell:allow-open",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "core:window:allow-close"
  ]
}
