{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PinWall",
  "version": "0.1.3",
  "identifier": "com.rain9.pinwall",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1930",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "",
        "width": 800,
        "height": 600,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "label": "main",
        "maximized": true,
        "resizable": false,
        "minimizable": false,
        "maximizable": false
      },
      {
        "title": "PinWall Settings",
        "width": 800,
        "height": 600,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "label": "settings",
        "visible": false
      },
      {
        "title": "",
        "width": 280,
        "height": 280,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "label": "notification",
        "visible": false,
        "resizable": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../widgets": "official-widgets"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rain9/pinwall/releases/download/latest/{{target}}-update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IGZpbGU6c3ByaW5nLXNpZ25hdHVyZS5zaWcK"
    }
  }
}
